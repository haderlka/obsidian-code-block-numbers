{
  "name": "code-block-numbers",
  "version": "1.0.0",
  "description": "Obsidian plugin: line numbers, file names and highlighted lines for code blocks.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings 0 && node tools/check-release.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "harness": "node tools/harness/build.mjs",
    "screenshots": "node tools/harness/build.mjs --shoot"
  },
  "keywords": [
    "obsidian-plugin",
    "code-block",
    "line-numbers",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1"
  },
  "author": "haderlka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haderlka/obsidian-code-block-numbers.git"
  },
  "homepage": "https://github.com/haderlka/obsidian-code-block-numbers#readme",
  "bugs": {
    "url": "https://github.com/haderlka/obsidian-code-block-numbers/issues"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
